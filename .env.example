# ─────────────────────────────────────────────────────────────────────────────
# AITools Platform — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS committer .env dans Git !
# ─────────────────────────────────────────────────────────────────────────────

# App
APP_NAME="AITools Platform"
DEBUG=false
SECRET_KEY=change-me-use-openssl-rand-hex-32

# CORS — URLs du frontend autorisées
ALLOWED_ORIGINS=["http://localhost:3000","https://votre-domaine.com"]

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Base de données PostgreSQL
DATABASE_URL=postgresql://aitools:aitools@localhost:5432/aitools

# Stockage fichiers
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
MAX_FILE_SIZE_MB=50

# Storage backend: "local" ou "s3"
STORAGE_BACKEND=local

# AWS S3 (si STORAGE_BACKEND=s3)
# S3_BUCKET=mon-bucket
# S3_REGION=eu-west-3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
